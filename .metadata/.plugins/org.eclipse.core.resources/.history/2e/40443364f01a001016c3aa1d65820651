package capston.Utilities.baseUtil;


import static capston.Utilities.baseUtil.ObjectLaunched.prop;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;

public class coreFunctions {

	protected WebDriver driver;

	
	public coreFunctions(WebDriver driver) {
		this.driver = driver;
	}
	
	public void navigateURL() {
		driver.get(prop.getProperty("applicationURL"));
	}

	public void type(String locator, String testData) {
		driver.findElement(By.xpath(prop.getProperty("username"))).sendKeys(testData);
	}

	public void clickElement(String locator) {
		driver.findElement(By.xpath(prop.getProperty("login"))).click();
	}
}
